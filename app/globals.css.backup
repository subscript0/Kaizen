@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    /* Motion.dev design tokens */
    --background: #0d1111;
    --background-light: #13181a;
    --foreground: #ededec;
    --foreground-feint: #7a8180;

    --primary: #e8eeee;           /* Accent color for interactive elements */
    --primary-foreground: #0d1111;
    --primary-hover: rgba(232, 238, 238, .08);

    --secondary: #a5b4fc;         /* Secondary accent */
    --secondary-foreground: #0d1111;

    --muted: #7a8180;
    --muted-foreground: #ededec;

    --border: #1e2427;
    --ring: #e8eeee;

    --success: #16a34a;
    --warning: #d97706;
    --error: #ef4444;

    /* Surface elevations */
    --surface: #13181a;
    --surface-deep: #060607;
    --surface-deepest: #030304;

    /* Motion tokens (OKLCH format converted to CSS values for ease of use) */
    --motion-snap: cubic-bezier(0.4, 0, 0.2, 1);       /* Quick, responsive */
    --motion-ui: cubic-bezier(0.25, 0.1, 0.25, 1.0);   /* Standard UI motion */
    --motion-gentle: cubic-bezier(0.4, 0, 0.6, 1);     /* Gentle, flowing */
    --motion-lively: cubic-bezier(0.68, -0.55, 0.265, 1.55); /* Bouncy, energetic */
    --motion-ambient: cubic-bezier(0.8, 0, 0.2, 1);    /* Soft, ambient */

    /* Motion token values (duration in ms) */
    --motion-duration-fast: 80ms;
    --motion-duration-normal: 150ms;
    --motion-duration-slow: 250ms;
  }

  /* ── Rounded elements consistent with motion.dev's design language */
  *,
  *::before,
  *::after {
    border-radius: var(--radius, 0.25rem);
  }

  /* Smooth theme colour transitions */
  html {
    transition: background-color 0.35s ease, color 0.35s ease;
  }
  /* Generic theme colour transition (interactive components own their own
     transitions below so transform-based hovers stay fast). */
  .transition-theme {
    transition-property: background-color, border-color, color, box-shadow;
    transition-duration: 0.35s;
    transition-timing-function: ease;
  }

  * {
    @apply border-border;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  /* ── Accessible focus ring (keyboard only) ── */
  :focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
    border-radius: calc(var(--radius) + 2px);
  }
  /* Don't show the ring for mouse clicks that land focus */
  :focus:not(:focus-visible) {
    outline: none;
  }

  body {
    background-color: hsl(var(--background));
    color: hsl(var(--foreground));
    font-family: var(--font-sans), ui-sans-serif, system-ui, sans-serif;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  ::selection {
    background-color: hsl(var(--primary) / 0.3);
    color: hsl(var(--foreground));
  }

  ::-webkit-scrollbar {
    width: 4px;
  }

  ::-webkit-scrollbar-track {
    background: hsl(var(--background));
  }

  ::-webkit-scrollbar-thumb {
    background: hsl(var(--primary) / 0.5);
    border-radius: 2px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: hsl(var(--primary));
  }

  /* ── Reduced-motion safety net ──
     GSAP reveals already honor this in JS; this covers CSS transitions,
     animations, and smooth scroll for users who ask for less motion. */
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
  }
}

@layer components {
  /* ════════════════════════════════════════════════════════════════
     SHARED NEO-BRUTALIST CONTRACT
     Reusable primitives every section agent builds on. Hard offset
     shadows, 2px ink borders, transform-based hover, active press.
     Only transform + box-shadow animate (Emil), ease-out, <300ms.
     ════════════════════════════════════════════════════════════════ */

  /* Paper surface, soft hairline border + rounded corners. Gentle lift and a
     soft ambient shadow on hover — no more hard offset block. */
  .nb-card {
    background: hsl(var(--background-light));
    border: 1px solid hsl(var(--border));
    border-radius: 0.9rem;
    transition: transform 0.25s var(--ease-out),
                box-shadow 0.25s var(--ease-out),
                border-color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nb-card:hover {
      transform: translateY(-4px);
      border-color: hsl(var(--foreground) / 0.18);
      box-shadow: 0 18px 40px -20px hsl(var(--foreground) / 0.28);
    }
  }

  /* Accent variant: the hover glow picks up the primary hue. */
  @media (hover: hover) and (pointer: fine) {
    .nb-card--accent:hover {
      border-color: hsl(var(--primary) / 0.45);
      box-shadow: 0 18px 44px -18px hsl(var(--primary) / 0.4);
    }
  }

  /* Accent-filled action button: pill-rounded, soft depth on hover,
     gentle settle on :active (framer springs handle the tactile feedback). */
  .nb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.75rem 1.75rem;
    min-height: 44px;
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    border: 1px solid transparent;
    border-radius: 0.7rem;
    box-shadow: 0 6px 18px -8px hsl(var(--primary) / 0.5);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s var(--ease-out),
                box-shadow 0.2s var(--ease-out),
                background-color 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nb-btn:hover {
      background: hsl(var(--primary-hover));
      transform: translateY(-2px);
      box-shadow: 0 14px 28px -10px hsl(var(--primary) / 0.55);
    }
  }

  .nb-btn:active {
    transform: translateY(0);
    box-shadow: 0 4px 12px -8px hsl(var(--primary) / 0.5);
  }

  /* Transparent variant: hairline border, ink text, same motion. */
  .nb-btn--outline {
    background: transparent;
    color: hsl(var(--foreground));
    border-color: hsl(var(--border));
    box-shadow: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .nb-btn--outline:hover {
      background: hsl(var(--secondary));
      color: hsl(var(--secondary-foreground));
      border-color: transparent;
      box-shadow: 0 12px 26px -12px hsl(var(--secondary) / 0.6);
    }
  }

  /* Editorial mono micro-label. */
  .nb-label {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: hsl(var(--primary));
  }

  /* ── Preloader ── */
  .preloader {
    position: fixed;
    inset: 0;
    background: black;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .preloader__text {
    font-size: clamp(2rem, 8vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: hsl(var(--foreground));
    overflow: hidden;
  }

  /* ── Scroll progress ── */
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    background: linear-gradient(
      to right,
      hsl(var(--primary)),
      hsl(var(--secondary))
    );
    z-index: 9996;
    transform-origin: left;
  }

  /* ── Sticky email ── */
  .sticky-email {
    position: fixed;
    right: -60px;
    bottom: 0;
    writing-mode: vertical-rl;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    z-index: 100;
  }

  .sticky-email a {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    transition: color 0.2s;
  }

  .sticky-email a:hover {
    color: hsl(var(--primary));
  }

  .sticky-email::after {
    content: '';
    display: block;
    width: 1px;
    height: 80px;
    background: hsl(var(--muted-foreground));
  }

  /* ── Noise texture overlay ── */
  .noise-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  }

  /* ── Section headings ── */
  .section-title {
    font-family: var(--font-serif), Georgia, serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.05;
  }

  .section-number {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: hsl(var(--primary));
    text-transform: uppercase;
    font-weight: 500;
  }

  /* ── Project card ── */
  .project-card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-bottom: 2px solid hsl(var(--foreground));
    padding: 2rem 0;
    overflow: hidden;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  @media (max-width: 768px) {
    .project-card {
      grid-template-columns: 1fr;
    }
  }

  .project-card:hover .project-card__title {
    color: hsl(var(--primary));
  }

  .project-image-follow {
    position: fixed;
    pointer-events: none;
    width: 300px;
    height: 200px;
    border-radius: 8px;
    overflow: hidden;
    z-index: 50;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity 0.3s ease;
  }

  @media (max-width: 768px) {
    .project-image-follow {
      display: none;
    }
  }

  /* ── Animations ── */
  .slide-up-and-fade {
    opacity: 0;
    transform: translateY(40px);
  }

  .slide-left-and-fade {
    opacity: 0;
    transform: translateX(-40px);
  }

  /* ── Skills grid ── */
  .skill-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.8rem;
    background: hsl(var(--background-light));
    transition: transform 0.25s var(--ease-out),
                box-shadow 0.25s var(--ease-out),
                border-color 0.25s ease,
                background-color 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-item:hover {
      background: hsl(var(--secondary));
      color: hsl(var(--secondary-foreground));
      transform: translateY(-4px);
      border-color: transparent;
      box-shadow: 0 16px 34px -18px hsl(var(--primary) / 0.4);
    }
  }

  /* ── CTA button ── */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.75rem 1.75rem;
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    border: 1px solid transparent;
    border-radius: 0.7rem;
    box-shadow: 0 6px 18px -8px hsl(var(--primary) / 0.5);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    min-height: 44px;
    transition: transform 0.2s var(--ease-out),
                box-shadow 0.2s var(--ease-out),
                background-color 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover {
      background: hsl(var(--primary-hover));
      transform: translateY(-2px);
      box-shadow: 0 14px 28px -10px hsl(var(--primary) / 0.55);
    }
  }

  .btn-primary:active {
    transform: translateY(0);
    box-shadow: 0 4px 12px -8px hsl(var(--primary) / 0.5);
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.75rem 1.75rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.7rem;
    color: hsl(var(--foreground));
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    min-height: 44px;
    background: transparent;
    transition: transform 0.2s var(--ease-out),
                box-shadow 0.2s var(--ease-out),
                border-color 0.25s ease,
                background-color 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-outline:hover {
      background: hsl(var(--secondary));
      color: hsl(var(--secondary-foreground));
      transform: translateY(-2px);
      border-color: transparent;
      box-shadow: 0 12px 26px -12px hsl(var(--secondary) / 0.6);
    }
  }

  .btn-outline:active {
    transform: translateY(0);
    box-shadow: none;
  }

  /* ── Experience item ── */
  .experience-item {
    opacity: 0;
    transform: translateX(-20px);
  }

  /* ── Particle canvas ── */
  #particle-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.4;
  }

  /* ── Testimonial card ── */
  .testimonial-card {
    background: hsl(var(--background-light));
    border: 1px solid hsl(var(--border));
    border-radius: 0.9rem;
    padding: 2rem;
    position: relative;
    transition: transform 0.25s var(--ease-out),
                box-shadow 0.25s var(--ease-out),
                border-color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .testimonial-card:hover {
      transform: translateY(-4px);
      border-color: hsl(var(--primary) / 0.4);
      box-shadow: 0 18px 44px -18px hsl(var(--primary) / 0.4);
    }
  }

  .testimonial-card::before {
    content: '"';
    position: absolute;
    top: -0.5rem;
    left: 1.5rem;
    font-size: 5rem;
    color: hsl(var(--primary) / 0.35);
    line-height: 1;
    font-family: Georgia, serif;
  }

  /* ── How I Think section ── */
  .approach-card {
    padding: 1.5rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.9rem;
    background: hsl(var(--background-light));
    transition: transform 0.25s var(--ease-out),
                box-shadow 0.25s var(--ease-out),
                border-color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .approach-card:hover {
      transform: translateY(-4px);
      border-color: hsl(var(--primary) / 0.4);
      box-shadow: 0 18px 44px -18px hsl(var(--primary) / 0.4);
    }
  }

  .approach-card__icon {
    width: 48px;
    height: 48px;
    border: 2px solid hsl(var(--foreground));
    background: hsl(var(--secondary));
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    color: hsl(var(--foreground));
  }
}

/* ── Magnetic morph cursor (motion.dev-style, sharp neobrutalist) ──────────── */
/* Hide the native cursor only while our custom cursor is active (desktop). */
.has-custom-cursor,
.has-custom-cursor * {
  cursor: none !important;
}

.mag-cursor-dot {
  position: fixed;
  top: 0;
  left: 0;
  width: 10px;
  height: 10px;
  background: hsl(var(--primary));
  pointer-events: none;
  z-index: 9998;
  will-change: transform;
}

.mag-cursor-box {
  position: fixed;
  top: 0;
  left: 0;
  width: 12px;
  height: 12px;
  border: 2px solid hsl(var(--foreground));
  background: transparent;
  pointer-events: none;
  z-index: 9997;
  will-change: transform, width, height;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

/* When morphing over an interactive target */
.mag-cursor-box.is-morph {
  background: hsl(var(--primary) / 0.1);
  border-color: hsl(var(--primary));
}

/* Click press feedback */
.mag-cursor-box.is-down {
  background: hsl(var(--primary) / 0.22);
}

/* Never show the custom cursor on touch / small screens */
@media (hover: none), (max-width: 640px) {
  .mag-cursor-dot,
  .mag-cursor-box {
    display: none !important;
  }
  .has-custom-cursor,
  .has-custom-cursor * {
    cursor: auto !important;
  }
}
