@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    /* Motion.dev-inspired palette — near-black surface, warm-white ink, one loud accent. */
    --background: 0 0% 3%;          /* #080808 */
    --background-light: 0 0% 6%;    /* #0f0f0f */
    --foreground: 60 3% 93%;        /* #E6E6DC */
    --foreground-muted: 56 5% 56%;  /* #909890 */

    --primary: 50 100% 60%;         /* #FBD509 - accent yellow */
    --primary-foreground: 0 0% 2%;  /* #060606 - near black for text on yellow */
    --primary-hover: 50 100% 66%;

    --secondary: 0 84% 60%;         /* #F83848 - coral red */
    --secondary-foreground: 0 0% 100%;

    --accent: 0 0% 97%;             /* #F8F8F8 - light card variant */
    --accent-foreground: 0 0% 0%;

    --border: 0 0% 14%;
    --input: 0 0% 10%;
    --ring: 50 100% 60%;

    /* Aliases — a lot of components reference these spellings directly via
       arbitrary values (hsl(var(--muted-foreground))) rather than through
       Tailwind's theme, so both names need to resolve to the same value. */
    --muted-foreground: var(--foreground-muted);
    --muted: var(--border);

    --radius: 0.125rem;              /* 2px — sharp corners, never pill (motion.dev/ui) */

    /* Geist for body/UI text, Sekuya for big display headlines only —
       both loaded via next/font in app/layout.tsx */
    --font-sans: var(--font-geist-sans), ui-sans-serif, system-ui, sans-serif;
    --font-mono: var(--font-geist-mono), ui-monospace, 'SF Mono', monospace;
    --font-display: var(--font-sekuya), var(--font-sans);

    /* Durations */
    --duration-short: 150ms;
    --duration-base: 200ms;
    --duration-medium: 400ms;
    --duration-long: 500ms;

    /* Spring-inspired easing */
    --ease-spring-1: cubic-bezier(0.4, 0, 0.2, 1);            /* snap */
    --ease-spring-2: cubic-bezier(0.25, 0.1, 0.25, 1.0);      /* ui / smooth reveal */
    --ease-spring-3: cubic-bezier(0.3, 0, 0.7, 1);            /* gentle entrance */
    --ease-spring-4: cubic-bezier(0.68, -0.55, 0.265, 1.55);  /* lively / bouncy */
    --ease-spring-5: cubic-bezier(0.4, 0, 0.6, 1);            /* ambient float */
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    font-size: 16px;
  }

  body {
    background-color: hsl(var(--background));
    color: hsl(var(--foreground));
    font-family: var(--font-sans), ui-sans-serif, system-ui, sans-serif;
    font-feature-settings: 'ss01' 1, 'cv01' 1;
    line-height: 1.5;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  ::selection {
    background-color: hsl(var(--primary) / 0.3);
    color: hsl(var(--foreground));
  }

  ::-webkit-scrollbar {
    width: 6px;
  }

  ::-webkit-scrollbar-track {
    background: hsl(var(--background));
  }

  ::-webkit-scrollbar-thumb {
    background: hsl(var(--primary) / 0.4);
    border-radius: 999px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: hsl(var(--primary) / 0.7);
  }

  :focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 2px;
    border-radius: 4px;
  }

  :focus:not(:focus-visible) {
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
  }
}

/* ══════════════════════════════════════════════════════════════════════════
   COMPONENT LAYER
   Shared primitives — big, legible type; soft cards; confident CTAs.
   ══════════════════════════════════════════════════════════════════════════ */
@layer components {
  /* ── Eyebrow / kicker label ── */
  .eyebrow,
  .section-number {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: hsl(var(--primary));
  }

  /* ── Headline scale — big, bold, tight leading, motion.dev-style.
     Sekuya display face is scoped to .text-display only (the home page
     hero headline) — every other page's section titles stay on Geist. ── */
  .text-display {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.95;
    font-size: clamp(2.25rem, 5.5vw, 5rem);
  }

  .section-title {
    font-family: var(--font-sans), ui-sans-serif, system-ui, sans-serif;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1;
    font-size: clamp(2.25rem, 6vw, 4.25rem);
  }

  .text-lede {
    font-size: clamp(1.05rem, 2vw, 1.375rem);
    line-height: 1.55;
    color: hsl(var(--foreground-muted));
    max-width: 46ch;
  }

  /* ── Buttons — small, dense, uppercase mono labels (Swiss/dev-tool tell).
     Flat: no box-shadow, no gradient. Feedback is color/border only. ── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    min-height: 40px;
    border-radius: var(--radius);
    font-family: var(--font-mono), ui-monospace, monospace;
    font-weight: 500;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    border: 1px solid transparent;
    transition: background-color var(--duration-base) ease,
                border-color var(--duration-base) ease,
                color var(--duration-base) ease;
  }

  .btn-primary {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover {
      background: hsl(var(--primary-hover));
    }
  }

  .btn-outline {
    background: transparent;
    color: hsl(var(--foreground));
    border-color: hsl(var(--border));
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-outline:hover {
      border-color: hsl(var(--primary));
      color: hsl(var(--primary));
    }
  }

  .btn-ghost {
    background: transparent;
    color: hsl(var(--foreground-muted));
    padding-inline: 0.75rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-ghost:hover {
      color: hsl(var(--foreground));
    }
  }

  /* ── Form fields — shared by every form on the site (Contact, /idea) ── */
  .input {
    display: block;
    width: 100%;
    background: hsl(var(--background-light) / 0.5);
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    color: hsl(var(--foreground));
    transition: border-color var(--duration-base) ease, background-color var(--duration-base) ease;
  }

  .input::placeholder {
    color: hsl(var(--foreground-muted) / 0.6);
  }

  .input:focus-visible {
    outline: none;
    border-color: hsl(var(--primary) / 0.6);
    background: hsl(var(--background-light) / 0.75);
  }

  textarea.input {
    resize: vertical;
    min-height: 6.5rem;
  }

  /* ── Card — generic surface used across the site. Flat: hairline border
     only, no drop-shadow. Translucency/blur stays (it's the glass look
     asked for elsewhere) — "no shadows, no gradients" targets decorative
     glow and gradient fills, not opacity. ── */
  .card {
    background: hsl(var(--background-light) / 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    transition: border-color var(--duration-base) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      border-color: hsl(var(--foreground) / 0.3);
    }
  }

  .card--accent:hover {
    border-color: hsl(var(--primary) / 0.6) !important;
  }

  /* ── Liquid glass — near-zero fill, blur doing the work, a plain hairline
     border (no gradient sheen — flattened per the Swiss/dev-tool direction).
     Use sparingly (nav, hero chrome), not the default card surface. ── */
  .liquid-glass {
    position: relative;
    background: hsl(var(--background-light) / 0.14);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid hsl(var(--foreground) / 0.14);
  }

  /* ── Legacy neo-brutalist aliases (kept for components still referencing them) ── */
  .nb-card {
    background: hsl(var(--background-light) / 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    transition: transform var(--duration-medium) var(--ease-spring-2),
                box-shadow var(--duration-medium) var(--ease-spring-2),
                border-color var(--duration-base) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nb-card:hover {
      transform: translateY(-4px);
      border-color: hsl(var(--foreground) / 0.18);
      box-shadow: 0 18px 40px -20px hsl(var(--foreground) / 0.28);
    }
  }

  .nb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.75rem 1.75rem;
    min-height: 44px;
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    cursor: pointer;
    transition: transform var(--duration-base) var(--ease-spring-2),
                box-shadow var(--duration-base) var(--ease-spring-2);
  }

  .nb-btn--outline {
    background: transparent;
    color: hsl(var(--foreground));
    border: 1px solid hsl(var(--border));
    box-shadow: none;
  }

  .nb-label {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: hsl(var(--primary));
  }

  /* ── Preloader ── */
  .preloader {
    position: fixed;
    inset: 0;
    background: hsl(var(--background));
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .preloader__text {
    font-size: clamp(2rem, 8vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: hsl(var(--foreground));
    overflow: hidden;
  }

  /* ── Scroll progress ── */
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    background: linear-gradient(to right, hsl(var(--primary)), hsl(var(--secondary)));
    z-index: 9996;
    transform-origin: left;
  }

  /* ── Sticky email rail ── */
  .sticky-email {
    position: fixed;
    right: -60px;
    bottom: 0;
    writing-mode: vertical-rl;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    z-index: 100;
  }

  .sticky-email a {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: hsl(var(--muted-foreground, var(--foreground-muted)));
    text-decoration: none;
    transition: color var(--duration-base) ease;
  }

  .sticky-email a:hover {
    color: hsl(var(--primary));
  }

  .sticky-email::after {
    content: '';
    display: block;
    width: 1px;
    height: 80px;
    background: hsl(var(--foreground-muted));
  }

  /* ── Noise texture overlay ── */
  .noise-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.02;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  }

  /* ── Project card (legacy full-bleed variant) ── */
  .project-card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid hsl(var(--border));
    padding: 2rem 0;
    overflow: hidden;
    cursor: pointer;
    transition: background-color var(--duration-medium) ease;
  }

  @media (max-width: 768px) {
    .project-card {
      grid-template-columns: 1fr;
    }
  }

  .project-card:hover .project-card__title {
    color: hsl(var(--primary));
  }

  .project-image-follow {
    position: fixed;
    pointer-events: none;
    width: 300px;
    height: 200px;
    border-radius: var(--radius);
    overflow: hidden;
    z-index: 50;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity var(--duration-medium) ease;
  }

  @media (max-width: 768px) {
    .project-image-follow {
      display: none;
    }
  }

  /* ── Testimonial card ── */
  .testimonial-card {
    background: hsl(var(--background-light) / 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: 2rem;
    position: relative;
    transition: transform var(--duration-medium) var(--ease-spring-2),
                box-shadow var(--duration-medium) var(--ease-spring-2),
                border-color var(--duration-base) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .testimonial-card:hover {
      transform: translateY(-4px);
      border-color: hsl(var(--primary) / 0.4);
      box-shadow: 0 18px 44px -18px hsl(var(--primary) / 0.4);
    }
  }

  /* ── Skills grid item ── */
  .skill-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    background: hsl(var(--background-light) / 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: transform var(--duration-medium) var(--ease-spring-2),
                box-shadow var(--duration-medium) var(--ease-spring-2),
                border-color var(--duration-base) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-item:hover {
      transform: translateY(-4px);
      border-color: hsl(var(--primary) / 0.4);
      box-shadow: 0 16px 34px -18px hsl(var(--primary) / 0.4);
    }
  }

  /* ── How I Think approach card ── */
  .approach-card {
    padding: 1.5rem;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    background: hsl(var(--background-light) / 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: transform var(--duration-medium) var(--ease-spring-2),
                box-shadow var(--duration-medium) var(--ease-spring-2),
                border-color var(--duration-base) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .approach-card:hover {
      transform: translateY(-4px);
      border-color: hsl(var(--primary) / 0.4);
      box-shadow: 0 18px 44px -18px hsl(var(--primary) / 0.4);
    }
  }

  .approach-card__icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  /* ── Experience item ── */
  .experience-item {
    opacity: 0;
    transform: translateX(-20px);
  }

  /* ── Generic reveal helpers ── */
  .slide-up-and-fade {
    opacity: 0;
    transform: translateY(40px);
  }

  .slide-left-and-fade {
    opacity: 0;
    transform: translateX(-40px);
  }

  #particle-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.4;
  }
}

/* ── Magnetic morph cursor (motion.dev-style, desktop only) ────────────────── */
.has-custom-cursor,
.has-custom-cursor * {
  cursor: none !important;
}

.mag-cursor-dot {
  position: fixed;
  top: 0;
  left: 0;
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: hsl(var(--primary));
  pointer-events: none;
  z-index: 9998;
  will-change: transform;
}

.mag-cursor-box {
  position: fixed;
  top: 0;
  left: 0;
  width: 12px;
  height: 12px;
  border-radius: 999px;
  border: 2px solid hsl(var(--foreground));
  background: transparent;
  pointer-events: none;
  z-index: 9997;
  will-change: transform, width, height;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.mag-cursor-box.is-morph {
  background: hsl(var(--primary) / 0.1);
  border-color: hsl(var(--primary));
}

.mag-cursor-box.is-down {
  background: hsl(var(--primary) / 0.22);
}

@media (hover: none), (max-width: 640px) {
  .mag-cursor-dot,
  .mag-cursor-box {
    display: none !important;
  }
  .has-custom-cursor,
  .has-custom-cursor * {
    cursor: auto !important;
  }
}

/* ── Utility classes ─────────────────────────────────────────────────────── */
.container {
  width: 100%;
}
@media (min-width: 640px) {
  .container { max-width: 640px; }
}
@media (min-width: 768px) {
  .container { max-width: 768px; }
}
@media (min-width: 1024px) {
  .container { max-width: 1024px; }
}
@media (min-width: 1280px) {
  .container { max-width: 1280px; }
}
@media (min-width: 1536px) {
  .container { max-width: 1536px; }
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.text-balance { text-wrap: balance; }
.text-pretty { text-wrap: pretty; }

.animate-pulse-slow {
  animation: pulse-slow 3s ease-in-out infinite;
}

@keyframes pulse-slow {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* ── Cinematic entrance — pure CSS, no JS timer to break in any browser.
   Used for above-the-fold content (the hero) that's visible at first
   paint, where a scroll-triggered reveal never gets a chance to matter. ── */
@keyframes fade-rise {
  from { opacity: 0; transform: translateY(24px); }
  to { opacity: 1; transform: translateY(0); }
}
.animate-fade-rise { animation: fade-rise 0.8s var(--ease-spring-2) both; }
.animate-fade-rise-delay { animation: fade-rise 0.8s var(--ease-spring-2) 0.15s both; }
.animate-fade-rise-delay-2 { animation: fade-rise 0.8s var(--ease-spring-2) 0.3s both; }
.animate-fade-rise-delay-3 { animation: fade-rise 0.8s var(--ease-spring-2) 0.45s both; }
.animate-fade-rise-delay-4 { animation: fade-rise 0.8s var(--ease-spring-2) 0.6s both; }

@media (prefers-reduced-motion: reduce) {
  .animate-fade-rise,
  .animate-fade-rise-delay,
  .animate-fade-rise-delay-2,
  .animate-fade-rise-delay-3,
  .animate-fade-rise-delay-4 {
    animation: none;
    opacity: 1;
    transform: none;
  }
}

.transition-transform {
  transition-property: transform;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
}

.transition-opacity {
  transition-property: opacity;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
}

.transition-colors {
  transition-property: background-color, border-color, color, fill, stroke;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
}

.transition-all {
  transition-property: all;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
}

.no-scrollbar::-webkit-scrollbar { display: none; }
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.border-bottom {
  border-bottom: 1px solid hsl(var(--border)) !important;
}
