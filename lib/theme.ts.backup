export type BaseMode   = 'dark' | 'light';
export type AccentName = 'blue' | 'red' | 'green' | 'purple' | 'orange' | 'yellow' | 'grey' | 'cyan' | 'tan' | 'pink';

export interface BaseTheme {
  label: string;
  background: string;
  backgroundLight: string;
  foreground: string;
  muted: string;
  mutedForeground: string;
  border: string;
}

export interface AccentTheme {
  label: string;
  swatch: string;
  primary: string;
  primaryHover: string;
  secondary: string;
  ring: string;
}

export const baseModes: Record<BaseMode, BaseTheme> = {
  // Warm "paper" — editorial cream/ink (Fluxly-inspired)
  light: {
    label: 'Paper',
    background:      '48 33% 97%',   // #fbfaf6 warm cream
    backgroundLight: '41 31% 94%',   // #f4f1ea deeper paper
    foreground:      '48 7% 13%',    // #24231f warm ink
    muted:           '44 16% 88%',   // soft warm fill
    mutedForeground: '45 5% 44%',    // #77746b
    border:          '44 16% 82%',   // #d8d4c9 hairline
  },
  // Warm dark — near-black paper, not techy blue
  dark: {
    label: 'Ink',
    background:      '105 7% 11%',    // #1b1e1a warm black
    backgroundLight: '100 8% 14%',    // raised surface
    foreground:      '49 19% 90%',    // #eae8e0 warm off-white
    muted:           '90 5% 18%',     // warm fill
    mutedForeground: '52 4% 57%',     // #96958e
    border:          '82 5% 23%',     // #3b3d37
  },
};

